
# --- App ---
PORT=4000

# --- MongoDB (Atlas: online cluster) ---
# Replace <DB_PASSWORD> with your actual password in your private .env (not committed).
# Optionally change the database name (order_payment_db).
MONGODB_URI=mongodb+srv://zakaria_akash:<DB_PASSWORD>@starting-cluster-01.5mukk.mongodb.net/order_payment_db?retryWrites=true&w=majority&appName=Starting-Cluster-01

# --- Redis ---
# Local Redis
REDIS_URL=redis://localhost:6379
# If using a hosted Redis (e.g., Upstash), comment the local line above and use this:
# REDIS_URL=rediss://:<REDIS_PASSWORD>@<YOUR_UPSTASH_ENDPOINT>:<PORT>

# --- JWT ---
# Use a long random string
JWT_SECRET=replace_with_a_long_random_string

# --- Gmail SMTP (Nodemailer) ---
# Use a Gmail App Password (NOT your regular Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_gmail_app_password
